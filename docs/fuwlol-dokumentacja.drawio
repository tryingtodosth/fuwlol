exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c55" target="c71"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c75" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2a5d8f;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#444444;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.9;entryX=1;entryY=0.3;" edge="1" parent="1" source="c58" target="c71"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c76" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#2a5d8f;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#444444;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=1;entryX=1;entryY=0.3;" edge="1" parent="1" source="c58" target="c72"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c77" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;ul style=&quot;margin:0;padding-left:26px&quot;&gt;&lt;li style=&quot;margin:0 0 7px 0&quot;&gt;&lt;b&gt;Niebieskie przerywane strzałki z api:&lt;/b&gt; /api/wayback/ (proxy z cache 24 h) i mail weryfikacyjny; do NASK aplikacja nie wysyła nic sama.&lt;/li&gt;&lt;li style=&quot;margin:0 0 7px 0&quot;&gt;&lt;b&gt;Jedno wejście HTTP:&lt;/b&gt; Traefik (Coolify) kieruje domenę na web:80; api i db nie mają portów publicznych.&lt;/li&gt;&lt;li style=&quot;margin:0 0 7px 0&quot;&gt;&lt;b&gt;Sesja:&lt;/b&gt; token DRF w localStorage, wysyłany tylko do PUBLIC_API_BASE_URL; logout kasuje token po obu stronach.&lt;/li&gt;&lt;li style=&quot;margin:0 0 7px 0&quot;&gt;&lt;b&gt;Pliki są sądzone po bajtach&lt;/b&gt; (archive/validators.py); JPEG/PNG/WebP tracą metadane (GPS).&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#444444;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="420" y="640" width="440" height="320" as="geometry"/></mxCell><mxCell id="c78" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;ul style=&quot;margin:0;padding-left:26px&quot;&gt;&lt;li style=&quot;margin:0 0 7px 0&quot;&gt;&lt;b&gt;Kwarantanna:&lt;/b&gt; pliki treści eskalowanej lub po opcji nuklearnej są PRZENOSZONE z /media do wolumenu evidence — zapamiętany URL odpowiada 404 (escalation/quarantine.py). Cache Cloudflare trzeba wyczyścić po URL-u osobno.&lt;/li&gt;&lt;li style=&quot;margin:0 0 7px 0&quot;&gt;&lt;b&gt;Adres klienta:&lt;/b&gt; X-Forwarded-For czytany od prawej wg FUWLOL_PROXY_HOPS (Traefik + nginx = 2); CF-Connecting-IP honorowany tylko z FUWLOL_CLOUDFLARE=1, gdy origin przyjmuje ruch wyłącznie z Cloudflare.&lt;/li&gt;&lt;li style=&quot;margin:0 0 7px 0&quot;&gt;&lt;b&gt;Kompilacja LaTeX-a dzieje się w przeglądarce&lt;/b&gt; — na serwerze nie ma TeX-a; ten sam kod renderuje edytor („Rekompiluj”) i stronę wpisu.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#444444;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="900" y="640" width="930" height="320" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="c510" name="4 Model danych"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c459" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="1080" as="geometry"/></mxCell><mxCell id="c460" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#175e4c;strokeColor=none;stro