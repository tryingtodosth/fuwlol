ight="290" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="c520" name="14 Testy i weryfikacja"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c499" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="1080" as="geometry"/></mxCell><mxCell id="c500" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#175e4c;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="14" as="geometry"/></mxCell><mxCell id="c501" value="fuw.lol — dokumentacja techniczna · stan na 17.09.2026 · źródło: docs/build_docs.py" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#777777;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="1028" width="1400" height="28" as="geometry"/></mxCell><mxCell id="c502" value="14 / 15" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#777777;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1630" y="1028" width="200" height="28" as="geometry"/></mxCell><mxCell id="c414" value="&lt;span style=&quot;letter-spacing:2px&quot;&gt;✱ TESTY I WERYFIKACJA&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=18;fontColor=#a84204;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="1740" height="30" as="geometry"/></mxCell><mxCell id="c415" value="&lt;div style=&quot;line-height:1.12&quot;&gt;Co jest sprawdzane automatycznie, a co ręcznie w przeglądarce&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=42;fontColor=#222222;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="78" width="1740" height="70" as="geometry"/></mxCell><mxCell id="c416" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#e6f1ee;strokeColor=#cccccc;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="90" y="190" width="400" height="150" as="geometry"/></mxCell><mxCell id="c417" value="&lt;div style=&quot;line-height:1.05&quot;&gt;135&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=46;fontColor=#175e4c;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="110" y="205" width="360" height="70" as="geometry"/></mxCell><mxCell id="c418" value="&lt;div style=&quot;line-height:1.3&quot;&gt;testów backendu (Django/DRF), w tym 23 nowe po przeglądzie 16.09&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=16;fontColor=#444444;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="110" y="270" width="360" height="60" as="geometry"/></mxCell><mxCell id="c419" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#e6f1ee;strokeColor=#cccccc;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="520" y="190" width="400" height="150" as="geometry"/></mxCell><mxCell id="c420" value="&lt;div style=&quot;line-height:1.05&quot;&gt;0 / 0&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=46;fontColor=#175e4c;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="540" y="205" width="360" height="70" as="geometry"/></mxCell><mxCell id="c421" value="&lt;div style=&quot;line-height:1.3&quot;&gt;błędów i ostrzeżeń svelte-check (238 plików)&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=16;fontColor=#444444;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="540" y="270" width="360" height="60" as="geometry"/></mxCell><mxCell id="c422" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#fff3d6;strokeColor=#cccccc;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="950" y="190" width="400" height="150" as="geometry"/></mxCell><mxCell id="c423" value="&lt;div style=&quot;line-height:1.05&quot;&gt;34&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=46;fontColor=#b4530a;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="970" y="205" width="360" height="70" as="geometry"/></mxCell><mxCell id="c424" value="&lt;div style=&quot;line-height:1.3&quot;&gt;kroków smoke testu w przeglądarce (frontend/e2e/smoke.mjs)&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=16;fontColor=#444444;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="970" y="270" width="360" height="60" as="geometry"/></mxCell><mxCell id="c425" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#e8f0f8;strokeColor=#cccccc;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1380" y="190" width="400" height="150" as="geometry"/></mxCell><mxCell id="c426" value="&lt;div style=&quot;line-height:1.05&quot;&gt;49&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=46;fontColor=#2a5d8f;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1400" y="205" width="360" height="70" as="geometry"/></mxCell><mxCell id="c427" value="&lt;div style=&quot;line-height:1.3&quot;&gt;zrzutów z 4 ról × 2 szerokości — frontend/e2e/survey.mjs, 0 błędów konsoli&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=16;fontColor=#444444;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1400" y="270" width="360" height="60" as="geometry"/></mxCell><mxCell id="c428" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;ul style=&quot;margin:0;padding-left:26px&quot;&gt;&lt;li style=&quot;margin:0 0 9px 0&quot;&gt;&lt;b&gt;backend/…/tests.py&lt;/b&gt;: uploady (bomba dekompresyjna, exe w .png, EXIF), uprawnienia (właściciel, staff), moderacja (hide/nuke/restore, stany, dziennik), zaufani (domeny, spoofing, token), czat (nick, limity, obrazki, zgłoszenia, kworum, reputacja), eskalacja (IDOR, „staff to nie head-admin”, zamrożenie, wyścig decyzji, dowody).&lt;/li&gt;&lt;li style=&quot;margin:0 0 9px 0&quot;&gt;&lt;b&gt;escalation/test_hardening.py&lt;/b&gt; (nowe): panel Django, kwarantanna plików (eskalacja, nuke, odrzucenie przy nuke), wyrocznie (liczniki, zgłoszenie, usunięcie komentarza, parent), e-mail zgłaszającego, review_note, throttle wpisów/komentarzy/logowania per login, nicki-homoglify, sól hasha IP, seed nie resetuje haseł.&lt;/li&gt;&lt;li style=&quot;margin:0 0 9px 0&quot;&gt;&lt;b&gt;Uruchomienie:&lt;/b&gt; &lt;span style=&quot;font-family:monospace;background:#f6f6f6;padding:0 4px&quot;&gt;cd backend &amp;amp;&amp;amp; ../.venv/bin/python manage.py test&lt;/span&gt; · &lt;span style=&quot;font-family:monospace;background:#f6f6f6;padding:0 4px&quot;&gt;cd frontend &amp;amp;&amp;amp; npm run check &amp;amp;&amp;amp; npm run build&lt;/span&gt; · przy działających serwerach &lt;span style=&quot;font-family:monospace;background:#f6f6f6;padding:0 4px&quot;&gt;npm run e2e&lt;/span&gt; i &lt;span style=&quot;font-family:monospace;background:#f6f6f6;padding:0 4px&quot;&gt;node e2e/survey.mjs&lt;/span&gt;.&lt;/li&gt;&lt;li style=&quot;margin:0 0 9px 0&quot;&gt;&lt;b&gt;Czego testy nie łapią:&lt;/b&gt; wyglądu — stąd survey.mjs i oglądanie zrzutów (tak znaleziono zdublowane wpisy na stronie głównej i szare placeholdery na telefonie); realnej konfiguracji proxy na serwerze (FUWLOL_PROXY_HOPS trzeba sprawdzić raz na produkcji, np. logując REMOTE_ADDR).&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#444444;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="370" width="860" height="560" as="geometry"/></mxCell><mxCell id="c429" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="974" y="364" width="862" height="551" as="geometry"/></mxCell><mxCell id="c430" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalAlign=top;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="980" y="370" width="850" height="539" as="geometry"/></mxCell><mxCell id="c431" value="/przegladaj — filtry w URL-u, więc wyszukiwanie jest linkiem" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#777777;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="980" y="919" width="850" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="c521" name="15 Analiza przepływów i rekomendacje"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c503" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="1080" as="geometry"/></mxCell><mxCell id="c504" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#175e4c;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="14" as="geometry"/></mxCell><mxCell id="c505" value="fuw.lol — dokumentacja techniczna · stan na 17.09.2026 · źródło: docs/build_docs.py" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#777777;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="1028" width="1400" height="28" as="geometry"/></mxCell><mxCell id="c506" value="15 / 15" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#777777;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1630" y="1028" width="200" height="28" as="geometry"/></mxCell><mxCell id="c432" value="&lt;span style=&quot;letter-spacing:2px&quot;&gt;✱ ANALIZA PRZEPŁYWÓW&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=18;fontColor=#a84204;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="1740" height="30" as="geometry"/></mxCell><mxCell id="c433" value="&lt;div style=&quot;line-height:1.12&quot;&gt;Trzy ścieżki użytkownika, ich tarcia i co warto zrobić następne&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=42;fontColor=#222222;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="78" width="1740" height="70" as="geometry"/></mxCell><mxCell id="c434" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#e6f1ee;strokeColor=#175e4c;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="90" y="175" width="560" height="640" as="geometry"/></mxCell><mxCell id="c435" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#175e4c;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="90" y="175" width="560" height="36" as="geometry"/></mxCell><mxCell id="c436" value="Gość: „szukam tego mema z kolokwium”" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=18;fontColor=#222222;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="180" width="540" height="28" as="geometry"/></mxCell><mxCell id="c437" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;ul style=&quot;margin:0;padding-left:26px&quot;&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;Strona główna → Przeglądaj (filtry w URL) → wpis → reakcja wymaga konta.&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Tarcie:&lt;/b&gt; na telefonie filtry zajmują cały ekran zanim pojawi się pierwszy wynik.&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Tarcie:&lt;/b&gt; lista osób i oś czasu to jeden klik dalej niż wyszukiwarka — mało kto tam trafia.&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Zrobione:&lt;/b&gt; placeholdery bez obrazka znikają na telefonie; strona główna nie powtarza wyróżnionych.&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Rekomendacja:&lt;/b&gt; zwinięte filtry na telefonie („Filtruj (2)”), wyszukiwanie w nagłówku zamiast lupy prowadzącej do /przegladaj.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#444444;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="104" y="222" width="532" height="590" as="geometry"/></mxCell><mxCell id="c438" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#fff3d6;strokeColor=#c98f1e;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="670" y="175" width="560" height="640" as="geometry"/></mxCell><mxCell id="c439" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c98f1e;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="670" y="175" width="560" height="36" as="geometry"/></mxCell><mxCell id="c440" value="Student: „dodam wpis”" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=18;fontColor=#222222;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="680" y="180" width="540" height="28" as="geometry"/></mxCell><mxCell id="c441" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;ul style=&quot;margin:0;padding-left:26px&quot;&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;Rejestracja → /dodaj (dane, pliki, treść z podglądem) → pending → /moje pokazuje status.&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Tarcie:&lt;/b&gt; długi formularz bez autozapisu — odświeżenie strony gubi treść.&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Tarcie:&lt;/b&gt; o odrzuceniu autor dowiaduje się tylko, jeśli sam zajrzy do /moje; nie ma maila ani znacznika „nowe”.&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Tarcie:&lt;/b&gt; brak resetu hasła — zablokowane konto to koniec.&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Rekomendacja:&lt;/b&gt; szkic w localStorage; mail/„dzwonek” o decyzji; reset hasła (SMTP już jest do weryfikacji).&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#444444;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="684" y="222" width="532" height="590" as="geometry"/></mxCell><mxCell id="c442" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#fbe9e0;strokeColor=#a84204;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1250" y="175" width="560" height="640" as="geometry"/></mxCell><mxCell id="c443" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a84204;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1250" y="175" width="560" height="36" as="geometry"/></mxCell><mxCell id="c444" value="Zaufany / staff: „coś tu nie powinno wisieć”" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=18;fontColor=#222222;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1260" y="180" width="540" height="28" as="geometry"/></mxCell><mxCell id="c445" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;ul style=&quot;margin:0;padding-left:26px&quot;&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;Wpis lub czat → Ukryj (dialog z powodem) → tablica; opcja nuklearna z powodem; NASK z powodem → head-admin.&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Zrobione:&lt;/b&gt; okna potwierdzenia zamiast prompt(); NASK odróżniony wizualnie; strona /eskalacje z dowodami i dwiema decyzjami; licznik „NASK (n)” w nawigacji.&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Tarcie:&lt;/b&gt; tablica i kolejka nie powiadamiają — moderator musi zaglądać; head-admin o eskalacji dowiaduje się dopiero po zalogowaniu.&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Tarcie:&lt;/b&gt; przy 12 linkach nawigacja staff zawija się w dwie linie.&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Rekomendacja:&lt;/b&gt; mail do head-admina przy eskalacji (najpilniejsze), dzienny mail „n w kolejce”, grupa „Moderacja ▾” w nawigacji.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#444444;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1264" y="222" width="532" height="590" as="geometry"/></mxCell><mxCell id="c446" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b&gt;Kolejność proponowana:&lt;/b&gt; 1) mail o eskalacji do head-admina i reset hasła (ten sam SMTP) · 2) autozapis szkicu i powiadomienie o decyzji · 3) zwinięte filtry i wyszukiwanie w nagłówku na telefonie · 4) grupa „Moderacja” w nawigacji · 5) research rynkowy (docs/research-brief-gemini.md) zanim dojdą kolejne funkcje — najpierw sprawdzić, skąd studenci naprawdę przynieśliby treść.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=16;fontColor=#444444;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="830" width="1740" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>