alue="—" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=16;fontColor=#444444;fontStyle=0;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1040" y="752" width="190" height="44" as="geometry"/></mxCell><mxCell id="c205" value="tylko powód" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=16;fontColor=#444444;fontStyle=0;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1230" y="752" width="200" height="44" as="geometry"/></mxCell><mxCell id="c206" value="✓" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=16;fontColor=#444444;fontStyle=0;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1430" y="752" width="200" height="44" as="geometry"/></mxCell><mxCell id="c207" value="✓" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=16;fontColor=#444444;fontStyle=0;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1630" y="752" width="200" height="44" as="geometry"/></mxCell><mxCell id="c208" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;ul style=&quot;margin:0;padding-left:26px&quot;&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Zaufany&lt;/b&gt; = konto z potwierdzonym adresem w domenie z tabeli TrustedDomain (fuw.edu.pl, uw.edu.pl, student.uw.edu.pl, instytuty PAN…). Dopasowanie ścisłe: lowercase ASCII, jedno @, subdomeny tylko tam, gdzie wiersz na to pozwala; &lt;span style=&quot;font-family:monospace;background:#f6f6f6;padding:0 4px&quot;&gt;x@fuw.edu.pl.evil.com&lt;/span&gt; nie przechodzi.&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Staff&lt;/b&gt; = Django is_staff. &lt;b&gt;Head-admin&lt;/b&gt; = is_superuser — jedyny poziom, na którym „staff” przestaje cokolwiek znaczyć (escalation/visibility.py). Nadawaj go jak najmniejszej liczbie osób.&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Reputacja&lt;/b&gt; (Profile.reputation): +1 gdy moderator potwierdzi ukrycie, do którego przyczyniło się Twoje zgłoszenie, −1 gdy je cofnie. Jeszcze niczego nie blokuje — jest zapisem, nie dźwignią.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=16;fontColor=#444444;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="820" width="1740" height="150" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="c512" name="6 Cykl życia wpisu"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c467" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="1080" as="geometry"/></mxCell><mxCell id="c468" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#175e4c;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="14" as="geometry"/></mxCell><mxCell id="c469" value="fuw.lol — dokumentacja techniczna · stan na 17.09.2026 · źródło: docs/build_docs.py" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#777777;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacing