<mxfile host="fuw.lol" type="device"><diagram id="c507" name="1 Tytuł"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c447" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="1080" as="geometry"/></mxCell><mxCell id="c448" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#175e4c;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="14" as="geometry"/></mxCell><mxCell id="c449" value="fuw.lol — dokumentacja techniczna · stan na 17.09.2026 · źródło: docs/build_docs.py" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#777777;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="1028" width="1400" height="28" as="geometry"/></mxCell><mxCell id="c450" value="1 / 15" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#777777;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1630" y="1028" width="200" height="28" as="geometry"/></mxCell><mxCell id="c1" value="&lt;span style=&quot;letter-spacing:3px&quot;&gt;DOKUMENTACJA TECHNICZNA I ANALIZA PRZEPŁYWÓW&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=18;fontColor=#a84204;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="190" width="900" height="40" as="geometry"/></mxCell><mxCell id="c2" value="fuw.lol" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=92;fontColor=#175e4c;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="240" width="900" height="120" as="geometry"/></mxCell><mxCell id="c3" value="&lt;div style=&quot;line-height:1.25&quot;&gt;Nieoficjalne, społecznościowe archiwum śmiesznych rzeczy z Wydziału Fizyki UW — memy, cytaty, legendarne zadania, zdjęcia, folklor, stare strony.&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=30;fontColor=#222222;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="360" width="860" height="120" as="geometry"/></mxCell><mxCell id="c4" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;ul style=&quot;margin:0;padding-left:26px&quot;&gt;&lt;li style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Stos:&lt;/b&gt; Django 5.2 + Django REST Framework (Postgres / SQLite lokalnie, tokeny) · SvelteKit 2 / Svelte 5 (SPA, adapter-static) · LaTeX.js + KaTeX w przeglądarce · marked + DOMPurify.&lt;/li&gt;&lt;li style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Wdrożenie:&lt;/b&gt; Hetzner + Coolify + Cloudflare, trzy kontenery (Postgres, Django/gunicorn, nginz ze zbudowaną aplikacją).&lt;/li&gt;&lt;li style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Wygląd&lt;/b&gt; celowo kopiuje www.fuw.edu.pl (Tahoma 13 px, zielony pasek #175e4c, ramki 1 px #ccc, ✱ przed nagłówkami) — to część żartu.&lt;/li&gt;&lt;li style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Ten dokument:&lt;/b&gt; architektura, model danych, role, cykl życia wpisu, zaufani i tablica moderacji, eskalacja do NASK, czat, wehikuł czasu, bezpieczeństwo (po przeglądzie z 16.09.2026), wdrożenie, testy i analiza przepływów z rekomendacjami.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=20;fontColor=#444444;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="520" width="860" height="260" as="geometry"/></mxCell><mxCell id="c5" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;span style=&quot;color:#777777&quot;&gt;Zrzuty ekranu pochodzą z działającej instancji deweloperskiej z treścią demo (postacie są fikcyjne). Stan na 17.09.2026.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=17;fontColor=#444444;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="830" width="860" height="60" as="geometry"/></mxCell><mxCell id="c6" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1024" y="184" width="792" height="772" as="geometry"/></mxCell><mxCell id="c7" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalAlign=top;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="1030" y="190" width="780" height="760" as="geometry"/></mxCell><mxCell id="c8" value="Strona główna — „Aktualności” Wydziału, tylko śmieszniej." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#777777;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1030" y="960" width="780" height="30" as