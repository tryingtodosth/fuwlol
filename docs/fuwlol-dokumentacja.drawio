e&lt;/span&gt;&lt;/div&gt;" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#fbe9e0;strokeColor=#a84204;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=17;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="510" width="200" height="80" as="geometry"/></mxCell><mxCell id="c217" value="&lt;div style=&quot;line-height:1.2&quot;&gt;eskalowany 🚨&lt;br&gt;&lt;span style=&quot;color:#777777&quot;&gt;nikt poza head-adminem&lt;/span&gt;&lt;/div&gt;" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#efe6f6;strokeColor=#5b3a8a;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=17;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="380" y="510" width="200" height="80" as="geometry"/></mxCell><mxCell id="c218" value="użytkownik" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#175e4c;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c211" target="c212"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c219" value="zaufany / staff" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#175e4c;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="c211" target="c213"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c220" value="publikuj" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#175e4c;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c212" target="c213"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c221" value="odrzuć" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#175e4c;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#444444;labelBack