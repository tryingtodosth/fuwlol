eStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#175e4c;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c213" target="c216"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c228" value="🚨 z każdego stanu" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#5b3a8a;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=0;exitY=0.7;entryX=1;entryY=0.3;" edge="1" parent="1" source="c215" target="c217"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c229" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;ul style=&quot;margin:0;padding-left:26px&quot;&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Numer katalogowy&lt;/b&gt; FUW-nnnn nadawany przy pierwszej publikacji; nie zmienia się przy ukryciu i przywróceniu.&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Odrzucony wpis&lt;/b&gt; autor może poprawić — edycja wraca do kolejki. Notatka moderatora jest widoczna tylko dla autora i staff (poprawka z przeglądu 16.09).&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Edycja opublikowanego wpisu&lt;/b&gt; przez zwykłego użytkownika też wraca do kolejki; zaufany i staff edytują w miejscu.&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Każda strzałka pisze ModerationAction&lt;/b&gt; (kto, kiedy, powód, stan poprzedni); „przywróć” czyta ten dziennik, żeby wrócić do stanu sprzed pierwszego ukrycia — nigdy prosto do „published”, jeśli wpis nie był zatwierdzony.&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Limity:&lt;/b&gt; 30 wpisów/h na konto, 25 MB na plik, 6 plików; komentarze 60/h (nowy limit).&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=16;fontColor=#444444;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="630" width="780" height="330" as="geometry"/></mxCell><mxCell id="c230" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="974" y="174" width="402" height="572" as="geometry"/></mxCell><mxCell id="c231" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalAlign=top;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="980" y="180" width="390" height="560" as="geometry"/></mxCell><mxCell id="c232" value="/dodaj — dane wpisu, pliki, treść z podglądem" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#777777;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="980" y="750" width="390" height="30" as="geometry"/></mxCell><mxCell id="c233" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1384" y="174" width="452" height="134" as="geometry"/></mxCell><mxCell id="c234" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalAlign=top;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="1390" y="180" width="440" height="122" as="geometry"/></mxCell><mxCell id="c235" value="/moderacja — kolejka: publikuj / odrzuć / ukryj / wyróżnij" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#777777;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1390" y="312" width="440" height="30" as="geometry"/></mxCell><mxCell id="c236" value="" s