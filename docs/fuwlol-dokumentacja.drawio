rget="c81"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c117" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#777777;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c93" target="c81"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c118" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#777777;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c96" target="c81"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c119" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#777777;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c108" target="c105"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c120" value="cel: Post | Comment | Message" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#a84204;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#444444;labelBackgroundColor=#ffffff;dashed=1;exitX=0.3;exitY=0;entryX=0.3;entryY=1;" edge="1" parent="1" source="c111" target="c81"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c121" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;ul style=&quot;margin:0;padding-left:26px&quot;&gt;&lt;li style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Pliki są cytowane po nazwie oryginalnej:&lt;/b&gt; wpis i jego pliki przychodzą w JEDNYM żądaniu multipart; treść mówi &lt;span style=&quot;font-family:monospace;background:#f6f6f6;padding:0 4px&quot;&gt;![](zdjecie.jpg)&lt;/span&gt; albo &lt;span style=&quot;font-family:monospace;background:#f6f6f6;padding:0 4px&quot;&gt;\\includegraphics{{zdjecie.jpg}}&lt;/span&gt;, a czytnik mapuje nazwę na URL (render/media.ts). Brak endpointu „wgraj najpierw” = brak osieroconych plików.&lt;/li&gt;&lt;li style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Nagrobek zamiast kasowania:&lt;/b&gt; usunięty komentarz zostaje w wątku jako placeholder (is_removed), żeby odpowiedzi nie straciły rodzica.&lt;/li&gt;&lt;li style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Data rozmyta:&lt;/b&gt; rok + dokładność (dokładnie / około / dekada) + notatka — folklor rzadko ma datę.&lt;/li&gt;&lt;li style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Każde przejście stanu pisze ModerationAction&lt;/b&gt; — tablica pokazuje kto, kiedy, dlaczego; restore wraca do stanu sprzed pierwszego ukrycia.&lt;/li&gt;&lt;li style=&quot;margin:0 0 10px 0&quot;&gt;&lt;b&gt;Eskalacja nie ma osobnych kolumn na 3 typy celów:&lt;/b&gt; GenericForeignKey, więc aplikacja escalation nie importuje modeli archive/board — jest liściem, o który pytają inni.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=17;fontColor=#444444;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="660" y="560" width="1170" height="400" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="c511" name="5 Role i uprawnienia"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c463" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="1080" as="geometry"/></mxCell><mxCell id="c464" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;ht