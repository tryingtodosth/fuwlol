ngLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="1028" width="1400" height="28" as="geometry"/></mxCell><mxCell id="c474" value="7 / 15" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#777777;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1630" y="1028" width="200" height="28" as="geometry"/></mxCell><mxCell id="c239" value="&lt;span style=&quot;letter-spacing:2px&quot;&gt;✱ ZAUFANI UŻYTKOWNICY&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=18;fontColor=#a84204;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="1740" height="30" as="geometry"/></mxCell><mxCell id="c240" value="&lt;div style=&quot;line-height:1.12&quot;&gt;Potwierdzony adres instytucjonalny daje narzędzia moderacji — bez kolejki i bez etatu&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=42;fontColor=#222222;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="78" width="1740" height="70" as="geometry"/></mxCell><mxCell id="c241" value="&lt;div style=&quot;line-height:1.2&quot;&gt;1. Rejestracja&lt;br&gt;&lt;span style=&quot;color:#777777&quot;&gt;login + hasło (walidatory Django)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#175e4c;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=16;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="200" width="230" height="90" as="geometry"/></mxCell><mxCell id="c242" value="&lt;div style=&quot;line-height:1.2&quot;&gt;2. /konto → adres&lt;br&gt;&lt;span style=&quot;color:#777777&quot;&gt;np. imie@fuw.edu.pl&lt;/span&gt;&lt;/div&gt;" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#175e4c;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=16;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="360" y="200" width="230" height="90" as="geometry"/></mxCell><mxCell id="c243" value="&lt;div style=&quot;line-height:1.2&quot;&gt;3. Sprawdzenie domeny&lt;br&gt;&lt;span style=&quot;color:#777777&quot;&gt;TrustedDomain, ścisłe dopasowanie&lt;/span&gt;&lt;/div&gt;" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#175e4c;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=16;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="630" y="200" width="260" height="90" as="geometry"/></mxCell><mxCell id="c244" value="&lt;div style=&quot;line-height:1.2&quot;&gt;4. Mail z linkiem&lt;br&gt;&lt;span style=&quot;color:#777777&quot;&gt;token 32 B, 24 h, jednorazowy&lt;/span&gt;&lt;/div&gt;" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#175e4c;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=16;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="930" y="200" width="230" height="90" as="geometry"/></mxCell><mxCell id="c245" value="&lt;div style=&quot;line-height:1.2&quot;&gt;5. /potwierdz?token=&lt;br&gt;&lt;span style=&quot;color:#777777&quot;&gt;ponowne sprawdzenie domeny&lt;/span&gt;&lt;/div&gt;" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#175e4c;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=16;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1200" y="200" width="230" height="90" as="geometry"/></mxCell><mxCell id="c246" value="&lt;div style=&quot;line-height:1.2&quot;&gt;6. zaufany ✓&lt;br&gt;&lt;span style=&quot;color:#777777&quot;&gt;Profile.verified_at&lt;/span&gt;&lt;/div&gt;" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#e6f1ee;strokeColor=#175e4c;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=16;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1470" y="200" width="230" height="90" as="geometry"/></mxCell><mxCell id="c247" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#175e4c;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c241" target="c242"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c248" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#175e4c;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c242" target="c243"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c249" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#175e4c;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c243" target="c244"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c250" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#175e4c;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c244" target="c245"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c251" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#175e4c;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c245" target="c246"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c252" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;ul style=&quot;margin:0;padding-left:26px&quot;&gt;&lt;li style=&quot;margin:0 0 9px 0&quot;&gt;&lt;b&gt;Dlaczego adres, a nie prośba do admina:&lt;/b&gt; członkostwo w społeczności jest sprawdzalne bez etatu moderatora — a to właśnie moderator jest wąskim gardłem takiego archiwum.&lt;/li&gt;&lt;li style=&quot;margin:0 0 9px 0&quot;&gt;&lt;b&gt;Co daje status zaufanego:&lt;/b&gt; wpisy publikują się od ręki; ukrywanie jednym kliknięciem (treść trafia na tablicę, gdzie każdy zaufany może ją przywrócić); opcja nuklearna dla treści nielegalnych lub obrzydliwie obraźliwych; zgłoszenie do NASK.&lt;/li&gt;&lt;li style=&quot;margin:0 0 9px 0&quot;&gt;&lt;b&gt;Czego nie daje:&lt;/b&gt; kolejki moderacji, cofnięcia opcji nuklearnej, wglądu w e-mail zgłaszającego, decyzji NASK.&lt;/li&gt;&lt;li style=&quot;margin:0 0 9px 0&quot;&gt;&lt;b&gt;Adres służy tylko do weryfikacji&lt;/b&gt; — nie jest pokazywany nikomu; w API wraca zamaskowany (&lt;span style=&quot;font-family:monospace;background:#f6f6f6;padding:0 4px&quot;&gt;j***@fuw.edu.pl&lt;/span&gt;). Domena może zostać wyłączona w panelu — wtedy &lt;span style=&quot;font-family:monospace;background:#f6f6f6;padding:0 4px&quot;&gt;is_trusted&lt;/span&gt; gaśnie, choć afiliacja pozostaje zapisana.&lt;/li&gt;&lt;li style=&quot;margin:0 0 9px 0&quot;&gt;&lt;b&gt;Limity:&lt;/b&gt; 5 maili/h na konto; logowanie 20/min na adres IP &lt;b&gt;i&lt;/b&gt; 10/min na login (nowe — przeciw rozproszonemu zgadywaniu hasła jednego konta).&lt;/li&gt;&lt;li style=&quot;margin:0 0 9px 0&quot;&gt;&lt;b&gt;Zostawione otwarte:&lt;/b&gt; brak resetu hasła (nie ma jeszcze maili poza weryfikacją); brak blokady konta po n nieudanych próbach — throttle liczy próby, nie porażki.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=16;fontColor=#444444;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="330" width="760" height="600" as="geometry"/></mxCell><mxCell id="c253" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="914" y="324" width="922" height="497" as="geometry"/></mxCell><mxCell id="c254" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalAlign=top;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="920" y="330" width="910" height="485" as="geometry"/></mxCell><mxCell id="c255" value="/konto — weryfikacja afiliacji z listą akceptowanych domen" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#777777;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="920" y="825" width="910" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="c514" name="8 Tablica moderacji"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c475" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="1080" as="geometry"/></mxCell><mxCell id="c476" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#175e4c;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="14" as="geometry"/></mxCell><mxCell id="c477" value="fuw.lol — dokumentacja techniczna · stan na 17.09.2026 · źródło: docs/build_docs.py" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#777777;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="1028" width="1400" height="28" as="geometry"/></mxCell><mxCell id="c478" value="8 / 15" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#777777;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1630" y="1028" width="200" height="28" as="geometry"/></mxCell><mxCell id="c256" value="&lt;span style=&quot;letter-spacing:2px&quot;&gt;✱ TABLICA MODERACJI I OPCJA NUKLEARNA&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=18;fontColor=#a84204;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="1740" height="30" as="geometry"/></mxCell><mxCell id="c257" value="&lt;div style=&quot;line-height:1.12&quot;&gt;Wszystko, co zniknęło ze strony publicznej — z podpisem, datą i powodem&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=42;fontColor=#222222;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="78" width="1740" height="70" as="geometry"/></mxCell><mxCell id="c258" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="84" y="174" width="912" height="612" as="geometry"/></mxCell><mxCell id="c25