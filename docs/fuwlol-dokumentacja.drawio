, cache&lt;/span&gt;&lt;/div&gt;" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#f6f6f6;strokeColor=#777777;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=16;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="470" y="240" width="200" height="110" as="geometry"/></mxCell><mxCell id="c57" value="&lt;div style=&quot;line-height:1.2&quot;&gt;web (nginx)&lt;br&gt;&lt;span style=&quot;color:#777777&quot;&gt;zbudowana aplikacja (200.html)&lt;br&gt;/api /admin /static → proxy&lt;br&gt;/media z wolumenu: nosniff,&lt;br&gt;CSP sandbox, PDF = attachment&lt;br&gt;CSP · X-Frame-Options · Referrer-Policy&lt;/span&gt;&lt;/div&gt;" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#175e4c;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=15;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="770" y="180" width="320" height="230" as="geometry"/></mxCell><mxCell id="c58" value="&lt;div style=&quot;line-height:1.2&quot;&gt;api (Django + gunicorn)&lt;br&gt;&lt;span style=&quot;color:#777777&quot;&gt;DRF, TokenAuthentication&lt;br&gt;archive · accounts · board · escalation&lt;br&gt;throttle w cache plikowym&lt;br&gt;RealIpMiddleware (hops, Cloudflare)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#175e4c;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=15;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1190" y="180" width="320" height="230" as="geometry"/></mxCell><mxCell id="c59" value="&lt;div style=&quot;line-height:1.2&quot;&gt;db&lt;br&gt;&lt;span style=&quot;color:#777777&quot;&gt;Postgres 16&lt;br&gt;(SQLite lokalnie)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#175e4c;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=16;fontColor=#222222;fontStyle