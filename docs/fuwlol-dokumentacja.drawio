eometry x="1030" y="364" width="200" height="46" as="geometry"/></mxCell><mxCell id="c282" value="placeholder" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#f6f6f6;strokeColor=#cccccc;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=14;fontColor=#444444;fontStyle=0;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1230" y="364" width="110" height="46" as="geometry"/></mxCell><mxCell id="c283" value="treść" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#f6f6f6;strokeColor=#cccccc;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=14;fontColor=#444444;fontStyle=0;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1340" y="364" width="250" height="46" as="geometry"/></mxCell><mxCell id="c284" value="treść" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#f6f6f6;strokeColor=#cccccc;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=14;fontColor=#444444;fontStyle=0;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1590" y="364" width="120" height="46" as="geometry"/></mxCell><mxCell id="c285" value="treść" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#f6f6f6;strokeColor=#cccccc;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=14;fontColor=#444444;fontStyle=0;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1710" y="364" width="120" height="46" as="geometry"/></mxCell><mxCell id="c286" value="komentarz pod wpisem nuked" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1;fontFamily=Helvetica;align=left;verticalAlign=middle;fontSize=14;fontColor=#444444;fontStyle=0;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1030" y="410" width="200" height="46" as="geometry"/></mxCell><mxCell id="c287" value="404" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=14;fontColor=#444444;fontStyle=0;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1230" y="410" width="110" height="46" as="geometry"/></mxCell><mxCell id="c288" value="403 (należy do treści, której nie widzi)" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=14;fontColor=#444444;fontStyle=0;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1340" y="410" width="250" height="46" as="geometry"/></mxCell><mxCell id="c289" value="treść" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=14;fontColor=#444444;fontStyle=0;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1590" y="410" width="120" height="46" as="geometry"/></mxCell><mxCell id="c290" value="treść" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=14;fontColor=#444444;fontStyle=0;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1710" y="410" width="120" height="46" as="geometry"/></mxCell><mxCell id="c291" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;ul style=&quot;margin:0;padding-left:26px&quot;&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Jedna reguła, dwie postacie:&lt;/b&gt; &lt;span style=&quot;font-family:monospace;background:#f6f6f6;padding:0 4px&quot;&gt;can_see_post(user, post)&lt;/span&gt; dla pojedynczego obiektu i &lt;span style=&quot;font-family:monospace;background:#f6f6f6;padding:0 4px&quot;&gt;visible_posts_q(user)&lt;/span&gt; dla querysetów — trzymane razem, żeby lista i szczegół nie mogły się rozjechać.&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Serializery wygaszają, a nie widoki filtrują:&lt;/b&gt; to, czego wywołujący nie może zobaczyć, jest wymazywane w serializerze (body=&#x27;&#x27;, author=&#x27;&#x27;), więc żaden nowy endpoint nie musi pamiętać o regule.&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Opcja nuklearna:&lt;/b&gt; powód obowiązkowy, zapis w dzienniku, pliki przenoszone do kwarantanny; cofnąć może tylko staff, a przywrócenie wraca do stanu sprzed ukrycia.&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Nie ma kasowania.&lt;/b&gt; Nagrobki, ukrycia, stuby — archiwum pamięta, że coś było, nawet gdy nie pokazuje co.&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Panel Django&lt;/b&gt; też respektuje eskalację (escalation/adminmixin.py) — poprawka z 16.09: wcześniej staff widział eskalowany wpis w /admin/.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#444444;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1030" y="480" width="800" height="480" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="c515" name="9 Eskalacja do NASK"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c479" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="1080" as="geometry"/></mxCell><mxCell id="c480" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#175e4c;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="14" as="geometry"/></mxCell><mxCell id="c481" value="fuw.lol — dokumentacja techniczna · stan na 17.09.2026 · źródło: docs/build_docs.py" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#777777;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="1028" width="1400" height="28" as="geometry"/></mxCell><mxCell id="c482" value="9 / 15" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#777777;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1630" y="1028" width="200" height="28" as="geometry"/></mxCell><mxCell id="c292" value="&lt;span style=&quot;letter-spacing:2px&quot;&gt;✱ ESKALACJA DO NASK (DYŻURNET.PL)&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=18;fontColor=#a84204;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="1740" height="30" as="geometry"/></mxCell><mxCell id="c293" value="&lt;div style=&quot;line-height:1.12&quot;&gt;Jedyny stan, w którym „zaufany” i nawet „staff” nic nie znaczą&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=42;fontColor=#222222;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="78" width="1740" height="70" as="geometry"/></mxCell><mxCell id="c294" value="Zaufany / moderator" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#175e4c;strokeColor=#175e4c;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=17;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="170" width="400" height="40" as="geometry"/></mxCell><mxCell id="c295" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#e6f1ee;strokeColor=#175e4c;strokeWidth=1;fontFamily=Helvetica;dashed=1;" vertex="1" parent="1"><mxGeometry x="90" y="210" width="400" height="340" as="geometry"/></mxCell><mxCell id="c296" value="System (escalation)" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#777777;strokeColor=#777777;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=17;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="500" y="170" width="400" height="40" as="geometry"/></mxCell><mxCell id="c297" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#f6f6f6;strokeColor=#777777;strokeWidth=1;fontFamily=Helvetica;dashed=1;" vertex="1" parent="1"><mxGeometry x="500" y="210" width="400" height="340" as="geometry"/></mxCell><mxCell id="c298" value="Head-admin" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#5b3a8a;strokeColor=#5b3a8a;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=17;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="910" y="170" width="400" height="40" as="geometry"/></mxCell><mxCell id="c299" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#efe6f6;strokeColor=#5b3a8a;strokeWidth=1;fontFamily=Helvetica;dashed=1;" vertex="1" parent="1"><mxGeometry x="910" y="210" width="400" height="340" as="geometry"/></mxCell><mxCell id="c300" value="Dyżurnet.pl" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#2a5d8f;strokeColor=#2a5d8f;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=17;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1320" y="170" width="400" height="40" as="geometry"/></mxCell><mxCell id="c301" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#e8f0f8;strokeColor=#2a5d8f;strokeWidth=1;fontFamily=Helvetica;dashed=1;" vertex="1" parent="1"><mxGeometry x="1320" y="210" width="400" height="340" as="geometry"/></mxCell><mxCell id="c302" value="&lt;div style=&quot;line-height:1.2&quot;&gt;🚨 „Zgłoś do NASK” + POWÓD (wymagany) w oknie potwierdzenia&lt;/div&gt;" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#175e4c;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=15;fontColor=#444444;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="105" y="225" width="370" height="64" as="geometry"/></mxCell><mxCell id="c303" value="&lt;div style=&quot;line-height:1.2&quot;&gt;Escalation(pending) + zamrożony pakiet: manifest.json (treść, autor, e-mail, data) + kopie plików, chmod 400, SHA-256 → evidence_ref&lt;/div&gt;" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#777777;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=15;fontColor=#444444;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="515" y="225" width="370" height="90" as="geometry"/></mxCell><mxCell id="c304" value="&lt;div style=&quot;line-height:1.2&quot;&gt;Pliki z /media → kwarantanna; treść znika ze WSZYSTKICH list, RSS, tablicy, panelu Django; zwykła moderacja = 403/404&lt;/div&gt;" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#777777;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=15;fontColor=#444444;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="515" y="330" width="370" height="64" as="geometry"/></mxCell><mxCell id="c305" value="&lt;div style=&quot;line-height:1.2&quot;&gt;Link „NASK (n)” w nawigacji; /eskalacje: powód, pakiet, pliki do pobrania przez uwierzytelniony widok&lt;/div&gt;" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b3a8a;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=15;fontColor=#444444;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="925" y="225" width="370" height="80" as="geometry"/></mxCell><mxCell id="c306" value="&lt;div style=&quot;line-height:1.2&quot;&gt;Decyzja: ZATWIERDŹ (pakiet kompletny) albo ODRZUĆ (to nie sprawa dla NASK), z notatką&lt;/div&gt;" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#5b3a8a;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=15;fontColor=#444444;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="925" y="330" width="370" height="64" as="geometry"/></mxCell><mxCell id="c307" value="&lt;div style=&quot;line-height:1.2&quot;&gt;Zgłoszenie przez formularz dyzurnet.pl — RĘCZNIE, przez człowieka. Aplikacja nigdy sama nie kontaktuje się z instytucją.&lt;/div&gt;" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2a5d8f;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=15;fontColor=#444444;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1335" y="330" width="370" height="90" as="geometry"/></mxCell><mxCell id="c308" value="&lt;div style=&quot;line-height:1.2&quot;&gt;approved: treść niewidoczna na stałe, pliki zostają w kwarantannie&lt;br&gt;declined: treść wraca pod zwykłą moderację, pliki wracają (chyba że ☢)&lt;/div&gt;" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#777777;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=15;fontColor=#444444;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="515" y="440" width="370" height="90" as="geometry"/></mxCell><mxCell id="c309" value="&lt;div style=&quot;line-height:1.2&quot;&gt;Powrót do tablicy — ukryj / przywróć działają znowu (po „odrzuć”)&lt;/div&gt;" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#175e4c;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=15;fontColor=#444444;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="105" y="440" width="370" height="64" as="geometry"/></mxCell><mxCell id="c310" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#175e4c;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c302" target="c303"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c311" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#175e4c;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c303" target="c304"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c312" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#175e4c;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c303" target="c305"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c313" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#175e4c;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c305" target="c306"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c314" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#175e4c;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c306" target="c307"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c315" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#175e4c;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=0;exitY=0.8;entryX=1;entryY=0.2;" edge="1" parent="1" source="c306" target="c308"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c316" value="" style="edgeStyle=none;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#777777;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#444444;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;entryX=1;entryY=0.5;" edge="1" parent="1" source="c308" target="c309"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c317" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;ul style=&quot;margin:0;padding-left:26px&quot;&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Dlaczego dowody są zamrażane w tej samej transakcji:&lt;/b&gt; autor może usunąć konto, moderator przywrócić wiadomość, plik może zostać podmieniony — pakiet ma przeżyć treść. Manifest i każdy plik mają SHA-256; katalog jest tylko do odczytu.&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Fail-closed:&lt;/b&gt; jeśli sprawdzenie „czy eskalowane?” rzuci wyjątek, odpowiedź brzmi „tak” — błąd w tym pliku ma powodować znikanie treści, nigdy jej ponowne pokazanie.&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Brak wyroczni:&lt;/b&gt; zaufany, który sam eskalował, dostaje 404, nie „już eskalowane”; identyfikatory eskalacji są sekwencyjne, ale każdy nie-head-admin dostaje 403 zanim widok cokolwiek wyszuka.&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Limit:&lt;/b&gt; 10 eskalacji/dobę na konto. &lt;b&gt;Rejestr:&lt;/b&gt; wiersz w bazie + linia w logu „security” (kompromitacja samej bazy nie zaciera śladu).&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#444444;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="580" width="1000" height="380" as="geometry"/></mxCell><mxCell id="c318" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1114" y="574" width="722" height="391" as="geometry"/></mxCell><mxCell id="c319" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalAlign=top;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="1120" y="580" width="710" height="379" as="geometry"/></mxCell><mxCell id="c320" value="/eskalacje — pakiet dowodowy i dwie decyzje (widok tylko dla head-admina)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#777777;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1120" y="969" width="710" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="c516" name="10 Czat"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c483" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="1080" as="geometry"/></mxCell><mxCell id="c484" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#175e4c;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="14" as="geometry"/></mxCell><mxCell id="c485" value="fuw.lol — dokumentacja techniczna · stan na 17.09.2026 · źródło: docs/build_docs.py" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#777777;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="1028" width="1400" height="28" as="geometry"/></mxCell><mxCell id="c486" value="10 / 15" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#777777;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1630" y="1028" width="200" height="28" as="geometry"/></mxCell><mxCell id="c321" value="&lt;span style=&quot;letter-spacing:2px&quot;&gt;✱ CZAT (SHOUTBOX)&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=18;fontColor=#a84204;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="1740" height="30" as="geometry"/></mxCell><mxCell id="c322" value="&lt;div style=&quot;line-height:1.12&quot;&gt;Pisze każdy, także bez konta — więc obrona jest tania i wielowarstwowa&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=42;fontColor=#222222;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="78" width="1740" height="70" as="geometry"/></mxCell><mxCell id="c323" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="84" y="174" width="832" height="358" as="geometry"/></mxCell><mxCell id="c324" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalAlign=top;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="90" y="180" width="820" height="346" as="geometry"/></mxCell><mxCell id="c325" value="/czat — nick gościa, tekst lub LaTeX, 2048 znaków, linki tak, obrazki nie" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#777777;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="536" width="820" height="30" as="geometry"/></mxCell><mxCell id="c326" value="&lt;div style=&quot;line-height:1.2&quot;&gt;Wiadomość&lt;br&gt;&lt;span style=&quot;color:#777777&quot;&gt;gość lub konto&lt;/span&gt;&lt;/div&gt;" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#175e4c;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=15;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="950" y="180" width="260" height="70" as="geometry"/></mxCell><mxCell id="c327" value="&lt;div style=&quot;line-height:1.2&quot;&gt;Zgłoszenie (każdy)&lt;br&gt;&lt;span style=&quot;color:#777777&quot;&gt;spam / obraźliwe / niezgodne z prawem / dotyczy mnie / inne&lt;/span&gt;&lt;/div&gt;" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#175e4c;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=14;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="950" y="290" width="260" height="70" as="geometry"/></mxCell><mxCell id="c328" value="&lt;div style=&quot;line-height:1.2&quot;&gt;3 różne konta ZAUFANE&lt;br&gt;&lt;span style=&quot;color:#777777&quot;&gt;→ auto-ukrycie, hidden_by = None&lt;/span&gt;&lt;/div&gt;" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#fff3d6;strokeColor=#c98f1e;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=14;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1290" y="290" width="260" height="70" as="geometry"/></mxCell><mxCell id="c329" value="&lt;div style=&quot;line-height:1.2&quot;&gt;Moderator: ukryj / przywróć&lt;br&gt;&lt;span style=&quot;color:#777777&quot;&gt;rozstrzyga wszystkie otwarte zgłoszenia&lt;/span&gt;&lt;/div&gt;" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#175e4c;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=14;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1290" y="400" width="260" height="70" as="geometry"/></mxCell><mxCell id="c330" value="&lt;div style=&quot;line-height:1.2&quot;&gt;Reputacja zgłaszających&lt;br&gt;&lt;span style=&quot;color:#777777&quot;&gt;+1 (ukrycie utrzymane) / −1 (cofnięte); nie dla samego moderatora&lt;/span&gt;&lt;/div&gt;" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#e8f0f8;strokeColor=#2a5d8f;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=13;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1290" y="510" width="260" height="70" as="geometry"/></mxCell><mxCell id="c331" value="&lt;div style=&quot;line-height:1.2&quot;&gt;🚨 do NASK&lt;br&gt;&lt;span style=&quot;color:#777777&quot;&gt;zaufany / staff; znika dla wszystkich&lt;/span&gt;&lt;/div&gt;" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#fbe9e0;strokeColor=#a84204;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=14;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1600" y="290" width="230" height="70" as="geometry"/></mxCell><mxCell id="c332" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#175e4c;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c326" target="c327"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c333" value="kworum" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#175e4c;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c327" target="c328"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c334" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#175e4c;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c328" target="c329"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c335" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#175e4c;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#444444;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="c329" target="c330"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c336" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#175e4c;strokeWidth=2;fontFamily=Helvetica;fontSize=16;fontColor=#444444;labelBackgroundColor=#ffffff;exitX=1;exitY=0.2;entryX=0;entryY=0.5;" edge="1" parent="1" source="c327" target="c331"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c337" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;ul style=&quot;margin:0;padding-left:26px&quot;&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Warstwy obrony:&lt;/b&gt; honeypot (pole website), limity 20/h gość i 60/h konto na adres IP, ≤ 5 linków, zakaz obrazków (![, &amp;lt;img, \\includegraphics, data:image), nick gościa ≠ żaden login — także po NFKC, wielkości liter, kropkach i mieszaniu alfabetów (Pіotr z cyrylicą і).&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Zgłoszenia gości nigdy nie ukrywają same&lt;/b&gt; — IP to nie tożsamość (NAT, wifi kampusu); liczą się tylko konta zaufane, każde raz.&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Ukryj, nie kasuj:&lt;/b&gt; hidden_by = None znaczy „zrobiły to zgłoszenia”, hidden_by = użytkownik — „moderator”. Moderator widzi liczbę otwartych zgłoszeń (⚑ n); gość nie widzi, ilu innych już zgłosiło.&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Adres IP&lt;/b&gt; jest przechowywany tylko jako HMAC-SHA256 z osobną solą (FUWLOL_IP_SALT) — wystarcza, by poznać „to samo miejsce”, nie by je odtworzyć.&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Stronicowanie po id&lt;/b&gt; (before / since), bo strumień rośnie od góry; RSS z 50 ostatnich, bez eskalowanych.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#444444;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="950" y="620" width="880" height="340" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="c517" name="11 Wehikuł czasu"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c487" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="1080" as="geometry"/></mxCell><mxCell id="c488" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#175e4c;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="14" as="geometry"/></mxCell><mxCell id="c489" value="fuw.lol — dokumentacja techniczna · stan na 17.09.2026 · źródło: docs/build_docs.py" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#777777;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="1028" width="1400" height="28" as="geometry"/></mxCell><mxCell id="c490" value="11 / 15" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#777777;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1630" y="1028" width="200" height="28" as="geometry"/></mxCell><mxCell id="c338" value="&lt;span style=&quot;letter-spacing:2px&quot;&gt;✱ WEHIKUŁ CZASU&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=18;fontColor=#a84204;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="1740" height="30" as="geometry"/></mxCell><mxCell id="c339" value="&lt;div style=&quot;line-height:1.12&quot;&gt;Jedna czysta funkcja eraFor(date) i rejestr wersji układu strony&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=42;fontColor=#222222;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="78" width="1740" height="70" as="geometry"/></mxCell><mxCell id="c340" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b&gt;przed Wielkim Wybuchem&lt;/b&gt;&lt;br&gt;nic — „przed” tam nie istnieje&lt;/div&gt;" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#777777;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=14;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="90" y="190" width="210.5" height="120" as="geometry"/></mxCell><mxCell id="c341" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b&gt;−13,8 mld → −66 mln&lt;/b&gt;&lt;br&gt;Wielki Wybuch (animacja), dinozaury&lt;/div&gt;" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#efe6f6;strokeColor=#5b3a8a;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=14;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="308.5" y="190" width="210.5" height="120" as="geometry"/></mxCell><mxCell id="c342" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b&gt;→ 1400&lt;/b&gt;&lt;br&gt;malowidła naskalne&lt;/div&gt;" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#f6f6f6;strokeColor=#777777;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=14;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="527.0" y="190" width="210.5" height="120" as="geometry"/></mxCell><mxCell id="c343" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b&gt;1400 → 1795&lt;/b&gt;&lt;br&gt;łacina, notatki Kopernika&lt;/div&gt;" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#e8f0f8;strokeColor=#2a5d8f;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=14;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="745.5" y="190" width="210.5" height="120" as="geometry"/></mxCell><mxCell id="c344" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b&gt;1795 → 1816&lt;/b&gt;&lt;br&gt;gazeta po niemiecku (pruska Warszawa)&lt;/div&gt;" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#e8f0f8;strokeColor=#2a5d8f;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=14;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="964.0" y="190" width="210.5" height="120" as="geometry"/></mxCell><mxCell id="c345" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b&gt;1816 → 1998&lt;/b&gt;&lt;br&gt;gazeta po polsku (UW od 1816)&lt;/div&gt;" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#fff3d6;strokeColor=#c98f1e;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=14;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1182.5" y="190" width="210.5" height="120" as="geometry"/></mxCell><mxCell id="c346" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b&gt;20.01.1998 → 10.09.2026&lt;/b&gt;&lt;br&gt;fuw.edu.pl z Internet Archive (iframe, sandbox)&lt;/div&gt;" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#e6f1ee;strokeColor=#175e4c;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=14;fontColor=#222222;" vertex="1" parent="1"><mxGeometry x="1401.0" y="190" width="210.5" height="120" as="geometry"/></mxCell><mxCell id="c347" value="&lt;div style=&quot;line-height:1.25&quot;&gt;&lt;b&gt;od 10.09.2026&lt;/b&gt;&lt;br&gt;nasze archiwum z tego dnia (?before=), układ z versions.ts&lt;/div&gt;" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#175e4c;strokeColor=#175e4c;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=14;fontColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1619.5" y="190" width="210.5" height="120" as="geometry"/></mxCell><mxCell id="c348" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#175e4c;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="90" y="320" width="1740" height="6" as="geometry"/></mxCell><mxCell id="c349" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;ul style=&quot;margin:0;padding-left:26px&quot;&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Dwa wejścia, bo jedno nie uniesie obu zadań:&lt;/b&gt; &lt;span style=&quot;font-family:monospace;background:#f6f6f6;padding:0 4px&quot;&gt;&amp;lt;input type=date&amp;gt;&lt;/span&gt; dla dat, które przeglądarka przyjmie, i pole tekstowe dla reszty osi (−13800000000 nie mieści się w kalendarzu). Lista „Skoki” wpisuje wartość do właściwego pola.&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Werdykt przed podróżą:&lt;/b&gt; pod formularzem stoi „Trafisz do: …” — użytkownik wie, co zobaczy, zanim kliknie „Jedź!”.&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Internet Archive:&lt;/b&gt; &lt;span style=&quot;font-family:monospace;background:#f6f6f6;padding:0 4px&quot;&gt;/api/wayback/&lt;/span&gt; rozwiązuje najbliższy zrzut po dacie (walidacja &lt;span style=&quot;font-family:monospace;background:#f6f6f6;padding:0 4px&quot;&gt;\\d{{8}}&lt;/span&gt;, stałe host i ścieżka — bez SSRF, timeout 8 s, cache 24 h); ramka ma sandbox bez allow-top-navigation i referrerpolicy=no-referrer.&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;versions.ts&lt;/b&gt; to rejestr układów strony: każda przyszła przebudowa dopisuje wersję i ZOSTAWIA stary komponent — dzięki temu stara data renderuje stary wygląd.&lt;/li&gt;&lt;li style=&quot;margin:0 0 8px 0&quot;&gt;&lt;b&gt;Otwarte:&lt;/b&gt; niemieckie i łacińskie epoki zachowują polskie tytuły wpisów (treść nie jest tłumaczona); wehikuł ma tylko strona główna.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#444444;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="350" width="860" height="420" as="geometry"/></mxCell><mxCell id="c350" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="994" y="344" width="842" height="270" as="geometry"/></mxCell><mxCell id="c351" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalAlign=top;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="1000" y="350" width="830" height="258" as="geometry"/></mxCell><mxCell id="c352" value="Formularz wehikułu na stronie głównej: data, rok, skoki, werdykt" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#777777;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1000" y="618" width="830" height="30" as="geometry"/></mxCell><mxCell id="c353" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="994" y="654" width="842" height="312" as="geometry"/></mxCell><mxCell id="c354" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalAlign=top;image=data:image/png,;" vertex="1" parent="1"><mxGeometry x="1000" y="660" width="830" height="300" as="geometry"/></mxCell><mxCell id="c355" value="/os-czasu — lata z liczbą wpisów, pogrupowane w dekady" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#777777;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1000" y="970" width="830" height="30" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="c518" name="12 Bezpieczeństwo"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c491" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="1080" as="geometry"/></mxCell><mxCell id="c492" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#175e4c;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="14" as="geometry"/></mxCell><mxCell id="c493" value="fuw.lol — dokumentacja techniczna · stan na 17.09.2026 · źródło: docs/build_docs.py" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#777777;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="1028" width="1400" height="28" as="geometry"/></mxCell><mxCell id="c494" value="12 / 15" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#777777;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1630" y="1028" width="200" height="28" as="geometry"/></mxCell><mxCell id="c356" value="&lt;span style=&quot;letter-spacing:2px&quot;&gt;✱ BEZPIECZEŃSTWO&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=18;fontColor=#a84204;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="1740" height="30" as="geometry"/></mxCell><mxCell id="c357" value="&lt;div style=&quot;line-height:1.12&quot;&gt;Trzy warstwy — i co zamknął przegląd z 16.09.2026&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=42;fontColor=#222222;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="78" width="1740" height="70" as="geometry"/></mxCell><mxCell id="c358" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#fff3d6;strokeColor=#c98f1e;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="90" y="180" width="560" height="470" as="geometry"/></mxCell><mxCell id="c359" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c98f1e;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="90" y="180" width="560" height="36" as="geometry"/></mxCell><mxCell id="c360" value="Pliki i treść" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=18;fontColor=#222222;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="100" y="185" width="540" height="28" as="geometry"/></mxCell><mxCell id="c361" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;ul style=&quot;margin:0;padding-left:26px&quot;&gt;&lt;li style=&quot;margin:0 0 7px 0&quot;&gt;Rozszerzenie z listy (bez SVG/HTML); decyzja po BAJTACH: Pillow musi zdekodować obraz (limit 40 Mpx z nagłówka — bomba dekompresyjna), PDF zaczyna się od %PDF, audio/wideo mają sygnaturę kontenera, tekst bez NUL.&lt;/li&gt;&lt;li style=&quot;margin:0 0 7px 0&quot;&gt;Nazwa na dysku = UUID + rozszerzenie; nazwa oryginalna tylko do cytowania w treści.&lt;/li&gt;&lt;li style=&quot;margin:0 0 7px 0&quot;&gt;JPEG/PNG/WebP zapisywane od nowa bez EXIF/ICC (GPS z telefonu); GIF i animowany WebP zostają (animacja to połowa memów).&lt;/li&gt;&lt;li style=&quot;margin:0 0 7px 0&quot;&gt;&lt;span style=&quot;color:#a84204&quot;&gt;NOWE:&lt;/span&gt; pliki treści eskalowanej i nuklearnej przenoszone poza /media (kwarantanna) — zapamiętany URL → 404.&lt;/li&gt;&lt;li style=&quot;margin:0 0 7px 0&quot;&gt;nginx: /media z nosniff, CSP „sandbox”, PDF/txt/tex jako attachment (nigdy nie renderują się na naszym originie).&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#444444;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="104" y="226" width="532" height="420" as="geometry"/></mxCell><mxCell id="c362" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#e6f1ee;strokeColor=#175e4c;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="670" y="180" width="560" height="470" as="geometry"/></mxCell><mxCell id="c363" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#175e4c;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="670" y="180" width="560" height="36" as="geometry"/></mxCell><mxCell id="c364" value="Renderowanie w przeglądarce" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=18;fontColor=#222222;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="680" y="185" width="540" height="28" as="geometry"/></mxCell><mxCell id="c365" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;ul style=&quot;margin:0;padding-left:26px&quot;&gt;&lt;li style=&quot;margin:0 0 7px 0&quot;&gt;Markdown (marked) → DOMPurify z listą tagów/atrybutów; LaTeX.js → DOMPurify (bez &amp;lt;style&amp;gt;, formularzy, ramek); KaTeX z trust=false po sanityzacji.&lt;/li&gt;&lt;li style=&quot;margin:0 0 7px 0&quot;&gt;&lt;span style=&quot;color:#a84204&quot;&gt;NOWE:&lt;/span&gt; obraz przeżywa sanityzację tylko, gdy jego src to URL naszego załącznika (albo blob: podglądu) — dotąd regex łapał tylko składnię ![](), a &amp;lt;img&amp;gt; i obrazy referencyjne przechodziły (piksel śledzący na każdego moderatora).&lt;/li&gt;&lt;li style=&quot;margin:0 0 7px 0&quot;&gt;&lt;span style=&quot;color:#a84204&quot;&gt;NOWE:&lt;/span&gt; atrybut class niedozwolony w treści użytkownika (podszywanie się pod plakietki „Wyróżnione”, fałszywe komunikaty moderacji).&lt;/li&gt;&lt;li style=&quot;margin:0 0 7px 0&quot;&gt;Każdy link: target=_blank, rel=nofollow noopener; javascript:/data: odrzucane.&lt;/li&gt;&lt;li style=&quot;margin:0 0 7px 0&quot;&gt;&lt;span style=&quot;color:#a84204&quot;&gt;NOWE:&lt;/span&gt; CSP w nginx (img-src self blob: data:, frame-src web.archive.org, frame-ancestors self), X-Frame-Options, Referrer-Policy, Permissions-Policy; HSTS z Django dla /api i /admin.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#444444;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="684" y="226" width="532" height="420" as="geometry"/></mxCell><mxCell id="c366" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#fbe9e0;strokeColor=#a84204;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1250" y="180" width="560" height="470" as="geometry"/></mxCell><mxCell id="c367" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a84204;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1250" y="180" width="560" height="36" as="geometry"/></mxCell><mxCell id="c368" value="Sieć, tożsamość, limity" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=18;fontColor=#222222;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1260" y="185" width="540" height="28" as="geometry"/></mxCell><mxCell id="c369" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;ul style=&quot;margin:0;padding-left:26px&quot;&gt;&lt;li style=&quot;margin:0 0 7px 0&quot;&gt;&lt;span style=&quot;color:#a84204&quot;&gt;NOWE:&lt;/span&gt; X-Forwarded-For czytany od prawej wg liczby zaufanych proxy (FUWLOL_PROXY_HOPS); CF-Connecting-IP tylko z FUWLOL_CLOUDFLARE=1. Dotąd pierwszy (kliencki) element sterował każdym limitem na IP.&lt;/li&gt;&lt;li style=&quot;margin:0 0 7px 0&quot;&gt;&lt;span style=&quot;color:#a84204&quot;&gt;NOWE:&lt;/span&gt; throttle per akcja na ViewSecie był cichym no-opem (scope czytany z widoku) — post_create 30/h, escalate 10/d i nowy comment_create 60/h działają teraz naprawdę, z testem regresji.&lt;/li&gt;&lt;li style=&quot;margin:0 0 7px 0&quot;&gt;&lt;span style=&quot;color:#a84204&quot;&gt;NOWE:&lt;/span&gt; logowanie limitowane także per login (10/min); walidatory haseł: długość, lista pospolitych, nie-numeryczne, niepodobne do loginu.&lt;/li&gt;&lt;li style=&quot;margin:0 0 7px 0&quot;&gt;&lt;span style=&quot;color:#a84204&quot;&gt;NOWE:&lt;/span&gt; seed_demo nie resetuje haseł istniejących kont, a poza DEBUG losuje hasła i wypisuje je raz; obraz Dockera ma FUWLOL_DEBUG=0 i odmawia startu z domyślnym SECRET_KEY.&lt;/li&gt;&lt;li style=&quot;margin:0 0 7px 0&quot;&gt;&lt;span style=&quot;color:#a84204&quot;&gt;NOWE:&lt;/span&gt; e-mail i notatka zgłaszającego tylko dla staff; review_note tylko dla autora; usunięcie komentarza i liczniki respektują eskalację; panel Django ukrywa treści eskalowane.&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=14;fontColor=#444444;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1264" y="226" width="532" height="420" as="geometry"/></mxCell><mxCell id="c370" value="&lt;div style=&quot;line-height:1.3&quot;&gt;&lt;b&gt;Przyjęte świadomie, nie zapomniane:&lt;/b&gt; token w localStorage (XSS = przejęcie sesji; CSP jest zabezpieczeniem drugiej linii, ciasteczko httpOnly to zmiana modelu auth) · jedno konto zaufane może eskalować (i zablokować) dowolną treść — 10/dobę, z pełnym rejestrem; to cena szybkiego działania przy CSAM · brak ClamAV (hosting go nie ma) — powiedziane, nie udawane · throttle liczy próby, nie porażki — pełna blokada konta po n nieudanych wymaga własnego mechanizmu · cache Cloudflare po kwarantannie trzeba wyczyścić ręcznie po URL-u · kwarantanna działa dla FileSystemStorage (jeden host) — S3 wymagałoby innej implementacji&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#444444;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="670" width="1740" height="300" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="c519" name="13 Wdrożenie"><mxGraphModel dx="0" dy="0" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1080" background="#ffffff" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c495" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="1080" as="geometry"/></mxCell><mxCell id="c496" value="" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#175e4c;strokeColor=none;strokeWidth=1;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1920" height="14" as="geometry"/></mxCell><mxCell id="c497" value="fuw.lol — dokumentacja techniczna · stan na 17.09.2026 · źródło: docs/build_docs.py" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#777777;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="1028" width="1400" height="28" as="geometry"/></mxCell><mxCell id="c498" value="13 / 15" style="text;html=1;strokeColor=none;fillColor=none;align=right;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=15;fontColor=#777777;fontStyle=0;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="1630" y="1028" width="200" height="28" as="geometry"/></mxCell><mxCell id="c371" value="&lt;span style=&quot;letter-spacing:2px&quot;&gt;✱ WDROŻENIE&lt;/span&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=18;fontColor=#a84204;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="44" width="1740" height="30" as="geometry"/></mxCell><mxCell id="c372" value="&lt;div style=&quot;line-height:1.12&quot;&gt;docker-compose: trzy kontenery, cztery wolumeny, wszystko z FUWLOL_* w środowisku&lt;/div&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;overflow=visible;fontFamily=Helvetica;fontSize=42;fontColor=#222222;fontStyle=1;spacing=0;spacingTop=0;spacingLeft=0;spacingRight=0;spacingBottom=0;" vertex="1" parent="1"><mxGeometry x="90" y="78" width="1740" height="70" as="geometry"/></mxCell><mxCell id="c373" value="&lt;div style=&quot;line-height:1.2&quot;&gt;web &lt;span style=&quot;color:#777777&quot;&gt;(frontend/Dockerfile)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#777777&quot;&gt;nginx + zbudowana aplikacja&lt;br&gt;port 80 → Traefik/Coolify&lt;/span&gt;&lt;/div&gt;" style="rounded=0;arcSize=0;whiteSpace=wrap;html=1;fillColor=#e6f1ee;strokeColor=#175e4c;strokeWidth=1;fontFamily=Helvetica;align=center;verticalAlign=middle;fontSize=16;fontColor=#222222;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="90" y="200" width="300" height="130" as="geometry"/></mxCell><mxCell id="c374" value="&lt;div style=&quot;line-height:1.2&quot;&gt;api &lt;span style=&quot;color:#777777&quot;&gt;(backend/Dockerfile)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;color:#777777&quot;&gt;gunicorn, użytkownik fuwlol (uid 1000)&lt;br&gt;entrypoint: migrate, collectstatic, [seed]&lt;/span&gt;&lt;/div&gt;" style="rounded=0;arcSize=