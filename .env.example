# docker compose / Coolify environment — copy to .env, never commit it
POSTGRES_PASSWORD=change-me-long-random
FUWLOL_SECRET_KEY=change-me-50-random-characters
FUWLOL_DOMAIN=fuw.lol
# a second secret for hashing visitor addresses (chat, evidence); optional but recommended
FUWLOL_IP_SALT=
# proxies in front of gunicorn that append to X-Forwarded-For: Traefik (Coolify) + nginx = 2
FUWLOL_PROXY_HOPS=2
# 1 only if the origin is reachable from Cloudflare alone (firewall or Tunnel) — see deploy/HETZNER.md
FUWLOL_CLOUDFLARE=0
# transactional mail (Brevo / Resend / SES — SMTP on 587; Hetzner blocks port 25)
FUWLOL_EMAIL_HOST=
FUWLOL_EMAIL_USER=
FUWLOL_EMAIL_PASSWORD=
FUWLOL_FROM_EMAIL=fuw.lol <archiwum@fuw.lol>
# 1 = create the demo accounts/content on first start (turn off afterwards)
FUWLOL_SEED_DEMO=0
GUNICORN_WORKERS=3
WEB_PORT=8080
