# docker compose / Coolify environment — copy to .env, never commit it
POSTGRES_PASSWORD=change-me-long-random
FUWLOL_SECRET_KEY=change-me-50-random-characters
FUWLOL_DOMAIN=fuw.lol
# a second secret for hashing visitor addresses (chat, evidence); optional but recommended
FUWLOL_IP_SALT=
# proxies in front of gunicorn that append to X-Forwarded-For: Traefik (Coolify) + nginx = 2
FUWLOL_PROXY_HOPS=2
# 1 only if the origin is reachable from Cloudflare alone (firewall or Tunnel) — see deploy/HETZNER.md
FUWLOL_CLOUDFLARE=0
# transactional mail (Brevo / Resend / SES — SMTP on 587; Hetzner blocks port 25)
FUWLOL_EMAIL_HOST=
FUWLOL_EMAIL_USER=
FUWLOL_EMAIL_PASSWORD=
FUWLOL_FROM_EMAIL="FUW <no-reply@fuw.lol>"
# The mailbox a HUMAN reads: DSA art. 12 contact, RODO requests, Dyzurnet replies.
FUWLOL_CONTACT_EMAIL=admin@fuw.lol
# 1 = create the demo accounts/content on first start (turn off afterwards)
FUWLOL_SEED_DEMO=0
GUNICORN_WORKERS=3
WEB_PORT=8080

# --- Cloudflare R2 for attachments (config/r2.py) -------------------------------------
# Unset = uploads go through Django to MEDIA_ROOT, exactly as before. Supported, and what a
# bare clone runs. Set all four to move attachment bytes out of the VPS entirely.
# THE BUCKET MUST HAVE VERSIONING OFF and no lifecycle rule that retains deleted objects:
# escalation/shred.py's hard delete is what makes a purge real, and a retained version
# would make it a lie (art. 202 § 4b k.k. — see DESIGN.md "The two takedowns").
FUWLOL_R2_BUCKET=
FUWLOL_R2_ENDPOINT_URL=
FUWLOL_R2_ACCESS_KEY_ID=
FUWLOL_R2_SECRET_ACCESS_KEY=
# The custom domain Cloudflare serves the bucket's public/ prefix from.
FUWLOL_R2_PUBLIC_BASE_URL=
# Purging the edge copy of a quarantined file (escalation/cdn.py). Unset = the purge is
# skipped and logged, never faked; edge copies then live until their TTL.
FUWLOL_CLOUDFLARE_ZONE_ID=
FUWLOL_CLOUDFLARE_PURGE_TOKEN=
# How long an uploader's raw IP / user-agent is kept on a Post before
# `manage.py forget_submitter_ips` blanks it. It exists only to be the identifying half of
# an art. 18 DSA report; kept longer it is a liability.
FUWLOL_SUBMITTER_IP_RETENTION_DAYS=90
