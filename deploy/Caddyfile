# fuw.lol — TLS termination in front of the existing nginx container.
#
# Why Caddy AND nginx, rather than one of them: frontend/nginx.conf carries the security
# posture that was reviewed on 16.09.2026 — the CSP, `sandbox` on /media, PDFs forced to
# attachment, the cache headers. Porting all of that into a Caddyfile to save one hop
# would risk losing a line of it quietly. Caddy does the one job nginx is awkward at here
# (certificates) and nothing else.
#
# The certificate is a CLOUDFLARE ORIGIN CERTIFICATE, not Let's Encrypt, and that is a
# consequence of the firewall: deploy/firewall.sh only lets Cloudflare's ranges reach 80
# and 443, so an ACME HTTP-01 challenge — which arrives from Let's Encrypt directly, not
# through Cloudflare — could never be answered. An origin certificate is trusted by
# Cloudflare alone, which is exactly the set of clients that can reach this port, and it
# is what Cloudflare's "Full (strict)" mode validates against.

{
	admin off
	servers {
		# Caddy must not believe an X-Forwarded-For it did not write. Only Cloudflare can
		# reach this port at all (firewall), so Cloudflare is the one hop it trusts.
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	}
}

(common) {
	encode zstd gzip
	tls /etc/caddy/secrets/origin.crt /etc/caddy/secrets/origin.key
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy web:80
}

fuw.lol {
	import common
}

www.fuw.lol {
	redir https://fuw.lol{uri} permanent
}
